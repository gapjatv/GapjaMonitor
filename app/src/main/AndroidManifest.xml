<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 포그라운드 서비스로 화면을 계속 캡처하기 위해 필요 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 접근성 방식(확인창 없음)으로 감시할 때의 포그라운드 서비스 종류 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 감시 중 알림 표시 (Android 13+ 에서는 사용자 허용이 필요하지만, 거부해도 동작한다) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 게임 화면 위에 보스 패널을 띄우기 위해 필요 (설정에서 사용자가 직접 허용) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        Android 11 부터는 다른 앱 이름을 보려면 미리 밝혀야 한다.
        게임(운빨존많겜)을 앱 이름으로 알아보기 위해, 홈 화면에 아이콘이 있는 앱들을 볼 수 있게 한다.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Gapja">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AnalysisActivity"
            android:exported="false"
            android:label="판별 기록 분석" />

        <!-- 게임 화면에서 보스만 잘라 인식용 사진으로 저장 -->
        <activity
            android:name=".CropActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="보스 사진 만들기" />
        <!-- ↑ 따로 떠 있는 화면으로 열어서, 저장하거나 취소하면 메인 화면이 아니라 게임으로 바로 돌아간다 -->

        <!-- 게임 위 [보스설정 → 시작] 때 화면 공유 동의만 받는 투명 화면 -->
        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Gapja.Transparent" />

        <!-- 저장된 보스 사진 · 로비 화면 보기 -->
        <activity
            android:name=".GalleryActivity"
            android:exported="false"
            android:label="저장된 보스 사진" />

        <!--
            태블릿(갤럭시 탭 등)에서도 쓰도록 화면 방향을 고정하지 않는다.
            화면을 돌리면 CaptureService 가 캡처 크기를 다시 맞춘다.
        -->

        <!--
            화면 캡처 서비스.
            foregroundServiceType="mediaProjection" 이 없으면 Android 14 이상에서
            MissingForegroundServiceTypeException 으로 즉시 죽는다.
        -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="게임 화면의 보스를 접근성 화면 찍기로 인식해 음성으로 알려 줌" />
        </service>

        <!-- 접근성 방식 화면 읽기 (확인창 없이 시작) — 설정 › 접근성 에서 사용자가 직접 켠다 -->
        <service
            android:name=".BossA11yService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/boss_a11y" />
        </service>

        <!-- 게임 위에 떠 있는 보스 패널 -->
        <service
            android:name=".OverlayService"
            android:exported="false" />

        <!-- 기록 파일(JSON/CSV)을 다른 앱으로 보낼 때 쓴다 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
